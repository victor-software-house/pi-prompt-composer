#!/usr/bin/env bash
#MISE description="Ensure pnpm-lock.yaml is in sync before push"

set -euo pipefail

pnpm install

if ! git diff --quiet -- pnpm-lock.yaml; then
  echo ""
  echo "Lockfile is out of sync. Commit the updated lockfile before pushing:"
  echo ""
  git diff --stat -- pnpm-lock.yaml
  echo ""
  echo "  git add pnpm-lock.yaml && git commit -m 'chore: sync lockfile'"
  echo ""
  exit 1
fi
