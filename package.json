{
	"name": "pi-prompt-composer",
	"version": "0.1.0",
	"description": "Build multi-option slash commands from plain prompts — variable expansion, arg collection & interactive selectors for Pi",
	"license": "MIT",
	"author": "Victor Software House",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/victor-software-house/pi-prompt-composer.git"
	},
	"homepage": "https://github.com/victor-software-house/pi-prompt-composer#readme",
	"bugs": {
		"url": "https://github.com/victor-software-house/pi-prompt-composer/issues"
	},
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent",
		"prompt-templates",
		"slash-commands",
		"coding-agent",
		"developer-tools",
		"llm",
		"openai",
		"prompt-engineering"
	],
	"pi": {
		"extensions": [
			"./extensions"
		],
		"image": "https://raw.githubusercontent.com/victor-software-house/pi-prompt-composer/main/assets/preview.png"
	},
	"type": "module",
	"files": [
		"extensions",
		"examples",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "bun run lint:biome && bun run lint:oxlint",
		"lint:biome": "biome check .",
		"lint:oxlint": "oxlint --import-plugin --type-aware --tsconfig=./tsconfig.json --ignore-pattern=test/ .",
		"lint:fix": "biome check --write .",
		"fix": "bun run fix:oxlint && bun run fix:biome",
		"fix:biome": "biome check --write .",
		"fix:oxlint": "oxlint --fix --import-plugin --type-aware --tsconfig=./tsconfig.json --ignore-pattern=test/ .",
		"test": "vitest --run",
		"test:watch": "vitest",
		"format": "biome format --write .",
		"prepare": "lefthook install"
	},
	"peerDependencies": {
		"@mariozechner/pi-coding-agent": "*",
		"@mariozechner/pi-tui": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@commitlint/cli": "^20.5.0",
		"@commitlint/config-conventional": "^20.5.0",
		"@limegrass/eslint-plugin-import-alias": "^1.6.1",
		"@marcfargas/pi-test-harness": "^0.5.0",
		"@mariozechner/pi-agent-core": "^0.63.0",
		"@mariozechner/pi-ai": "^0.63.0",
		"@mariozechner/pi-coding-agent": "^0.63.0",
		"@mariozechner/pi-tui": "^0.63.0",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^12.0.6",
		"@semantic-release/npm": "^13.1.5",
		"eslint-plugin-zod": "^3.5.0",
		"lefthook": "^2.1.4",
		"oxlint": "^1.56.0",
		"oxlint-tsgolint": "^0.19.0",
		"semantic-release": "^25.0.3",
		"typescript": "^5.9.3",
		"vitest": "^4.0.0"
	}
}
